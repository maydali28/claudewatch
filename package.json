{
  "name": "claudewatch",
  "version": "1.2.10",
  "description": "Claude Code session explorer (macOS, Windows, Linux)",
  "main": "out/main/index.js",
  "author": {
    "name": "Mohamed Ali May",
    "email": "may.mohamedali28@gmail.com"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "build": {
    "publish": [
      {
        "provider": "generic",
        "url": "${RELEASES_URL}",
        "useMultipleRangeRequest": false
      }
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "fs-xattr",
      "macos-alias"
    ],
    "overrides": {
      "esbuild@<=0.24.2": ">=0.25.0",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "prismjs@<1.30.0": ">=1.30.0",
      "tmp@<0.2.6": ">=0.2.6",
      "lodash@<=4.17.23": ">=4.18.0",
      "rimraf@<6": ">=6.0.1",
      "@tootallnate/once@<3": ">=3.0.1",
      "@opentelemetry/core@<2.8.0": ">=2.8.0",
      "@babel/core@<=7.29.0": ">=7.29.6",
      "js-yaml@>=5.0.0 <5.2.2": ">=5.2.2",
      "brace-expansion@>=5.0.0 <5.0.9": ">=5.0.9",
      "fast-uri@>=3.0.0 <3.1.6": ">=3.1.6 <4",
      "@xmldom/xmldom@<0.9.12": ">=0.9.12",
      "baseline-browser-mapping@<2.11.0": ">=2.11.0",
      "brace-expansion@>=1.0.0 <1.1.18": ">=1.1.18 <2",
      "brace-expansion@>=2.0.0 <2.1.4": ">=2.1.4 <3",
      "browserslist@>=4.0.0 <4.28.7": ">=4.28.7 <5",
      "fflate@<0.8.3": ">=0.8.3",
      "ip-address@>=10.0.0 <10.3.1": ">=10.3.1 <11",
      "nanoid@>=3.0.0 <3.3.18": ">=3.3.18 <4",
      "postcss@>=8.0.0 <8.5.23": ">=8.5.23 <9",
      "tar@<7.5.21": ">=7.5.21 <8",
      "undici@<8.9.0": ">=8.9.0"
    },
    "patchedDependencies": {
      "appdmg@0.6.6": "patches/appdmg@0.6.6.patch"
    }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -b --force",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "depcruise": "depcruise --config .dependency-cruiser.cjs \"src/**/*.{ts,tsx}\"",
    "depcruise:graph": "depcruise --config .dependency-cruiser.cjs --output-type dot \"src/**/*.{ts,tsx}\" | dot -Tsvg > dependency-graph.svg",
    "size-check": "node scripts/check-bundle-size.mjs",
    "smoke:preferences": "node scripts/smoke-preferences.mjs",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "package": "electron-vite build && electron-forge package",
    "make": "electron-vite build && electron-forge make",
    "publish": "electron-vite build && electron-forge publish",
    "commit": "git-cz",
    "changelog": "node scripts/generate-changelog.mjs",
    "changelog:all": "node scripts/generate-changelog.mjs --all",
    "release": "node scripts/release.mjs",
    "prepare": "husky",
    "postinstall": "node node_modules/electron/install.js"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{js,mjs,cjs,json,css,md}": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@sentry/electron": "^7.18.0",
    "chokidar": "^5.0.0",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "semver": "^7.8.5",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "clsx": "^2.1.1",
    "commitizen": "^4.3.2",
    "conventional-changelog": "^7.2.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "date-fns": "^4.4.0",
    "dependency-cruiser": "^18.2.0",
    "electron": "^43.7.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "lucide-react": "^1.45.0",
    "node-gyp": "^12.4.0",
    "prettier": "^3.9.6",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "react-window": "^2.3.1",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "zustand": "^5.0.15"
  }
}
