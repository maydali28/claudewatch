{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus[1m]",
  "tui": "fullscreen",
  "statusLine": {
    "type": "command",
    "command": "bash /Users/you/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "hooks": {
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/you/.claude/hooks/pre_compact_save.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__memcp__memcp_remember",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/you/.claude/hooks/reset_counter.py"
          }
        ]
      }
    ]
  },
  "cleanupPeriodDays": 30,
  "switchModelsOnFlag": false,
  "agentPushNotifEnabled": true
}
